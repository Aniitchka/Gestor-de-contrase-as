import json
import os
import base64
from getpass import getpass
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

VAULT_FILE = "vault.json"
SALT_FILE = "salt.bin"

# 1. Derivación de Clave (PBKDF2 + SHA256)
def generate_key(master_password: str, salt: bytes) -> bytes:
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,  # 256 bits para AES-256
        salt=salt,
        iterations=600000,  # Recomendado por OWASP
    )
    return kdf.derive(master_password.encode())

# 2. Cifrado con AES-256-GCM
def encrypt_data(data: str, key: bytes) -> dict:
    aesgcm = AESGCM(key)
    nonce = os.urandom(12)  # Genera un vector de inicialización único
    encrypted_bytes = aesgcm.encrypt(nonce, data.encode(), None)
    return {
        "nonce": base64.b64encode(nonce).decode('utf-8'),
        "ciphertext": base64.b64encode(encrypted_bytes).decode('utf-8')
    }

# 3. Descifrado con AES-256-GCM
def decrypt_data(encrypted_dict: dict, key: bytes) -> str:
    aesgcm = AESGCM(key)
    nonce = base64.b64decode(encrypted_dict["nonce"])
    ciphertext = base64.b64decode(encrypted_dict["ciphertext"])
    decrypted_bytes = aesgcm.decrypt(nonce, ciphertext, None)
    return decrypted_bytes.decode('utf-8')

# Inicializar Salt
def get_or_create_salt() -> bytes:
    if not os.path.exists(SALT_FILE):
        salt = os.urandom(16)
        with open(SALT_FILE, "wb") as f:
            f.write(salt)
        return salt
    with open(SALT_FILE, "rb") as f:
        return f.read()

# Cargar Vault
def load_vault() -> dict:
    if not os.path.exists(VAULT_FILE):
        return {}
    with open(VAULT_FILE, "r") as f:
        return json.load(f)

# Guardar Vault
def save_vault(vault: dict):
    with open(VAULT_FILE, "w") as f:
        json.dump(vault, f, indent=4)

# Menú Principal
def main():
    print("=== MI GESTOR DE CONTRASEÑAS SECURE-CLI ===")
    salt = get_or_create_salt()
    
    master_pw = getpass("Ingresa tu contraseña maestra: ")
    key = generate_key(master_pw, salt)

    vault = load_vault()

    while True:
        print("\nOpciones:")
        print("1. Guardar nueva contraseña")
        print("2. Ver contraseña guardada")
        print("3. Listar servicios")
        print("4. Salir")
        
        choice = input("\nSelecciona una opción (1-4): ")

        if choice == "1":
            service = input("Nombre del servicio/sitio (ej. Proton, Github): ").lower()
            password = getpass(f"Ingresa la contraseña para {service}: ")
            encrypted = encrypt_data(password, key)
            vault[service] = encrypted
            save_vault(vault)
            print(f"¡Contraseña para '{service}' guardada y cifrada con éxito!")

        elif choice == "2":
            service = input("Nombre del servicio a consultar: ").lower()
            if service in vault:
                try:
                    decrypted_pw = decrypt_data(vault[service], key)
                    print(f"Contraseña para {service}: {decrypted_pw}")
                except Exception:
                    print("Error: Contraseña maestra incorrecta o datos corruptos.")
            else:
                print("Servicio no encontrado.")

        elif choice == "3":
            if vault:
                print("\nServicios guardados:")
                for s in vault.keys():
                    print(f" - {s}")
            else:
                print("📭 El baúl está vacío.")

        elif choice == "4":
            print("Saliendo del gestor seguro...")
            break
        else:
            print("Opción no válida.")

if __name__ == "__main__":
    main()