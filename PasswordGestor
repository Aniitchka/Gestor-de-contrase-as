import json
import os
import base64
import string
import secrets
import pyperclip
from getpass import getpass
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

VAULT_FILE = "vault.json"
SALT_FILE = "salt.bin"

# 1. Derivación de Clave (PBKDF2 + SHA256 con 600k iteraciones)
def generate_key(master_password: str, salt: bytes) -> bytes:
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=600000,
    )
    return kdf.derive(master_password.encode())

# 2. Cifrado con AES-256-GCM
def encrypt_data(data: str, key: bytes) -> dict:
    aesgcm = AESGCM(key)
    nonce = os.urandom(12)
    encrypted_bytes = aesgcm.encrypt(nonce, data.encode(), None)
    return {
        "nonce": base64.b64encode(nonce).decode('utf-8'),
        "ciphertext": base64.b64encode(encrypted_bytes).decode('utf-8')
    }

# 3. Descifrado con AES-256-GCM
def decrypt_data(encrypted_dict: dict, key: bytes) -> str:
    aesgcm = AESGCM(key)
    nonce = base64.b64decode(encrypted_dict["nonce"])
    ciphertext = base64.b64decode(encrypted_dict["ciphertext"])
    decrypted_bytes = aesgcm.decrypt(nonce, ciphertext, None)
    return decrypted_bytes.decode('utf-8')

# 4. Generador de contraseñas criptográficamente seguras
def generate_secure_password(length: int = 18) -> str:
    alphabet = string.ascii_letters + string.digits + "!@#$%^&*()_+-=[]{}|;:,.<>?"
    while True:
        password = ''.join(secrets.choice(alphabet) for _ in range(length))
        # Garantizar que contenga al menos una mayúscula, minúscula, número y símbolo
        if (any(c.islower() for c in password) and
            any(c.isupper() for c in password) and
            any(c.isdigit() for c in password) and
            any(c in "!@#$%^&*()_+-=[]{}|;:,.<>?" for c in password)):
            return password

# Manejo de Salt y Vault
def get_or_create_salt() -> bytes:
    if not os.path.exists(SALT_FILE):
        salt = os.urandom(16)
        with open(SALT_FILE, "wb") as f:
            f.write(salt)
        return salt
    with open(SALT_FILE, "rb") as f:
        return f.read()

def load_vault() -> dict:
    if not os.path.exists(VAULT_FILE):
        return {}
    with open(VAULT_FILE, "r") as f:
        return json.load(f)

def save_vault(vault: dict):
    with open(VAULT_FILE, "w") as f:
        json.dump(vault, f, indent=4)

# Menú Principal
def main():
    print("=== GESTOR DE CONTRASEÑAS SECURE-CLI v2.0 ===")
    salt = get_or_create_salt()
    
    master_pw = getpass("Ingresa tu contraseña maestra: ")
    key = generate_key(master_pw, salt)

    vault = load_vault()

    while True:
        print("\n--- MENÚ PRINCIPAL ---")
        print("1. Guardar nueva contraseña (manual o generada)")
        print("2. Ver / Copiar contraseña guardada")
        print("3. Listar servicios")
        print("4. Generar contraseña aleatoria rápida")
        print("5. Salir")
        
        choice = input("\nSelecciona una opción (1-5): ")

        if choice == "1":
            service = input("Nombre del servicio/sitio (ej. Proton, Github): ").lower().strip()
            
            gen_option = input("¿Quieres generar una contraseña aleatoria ultra segura? (s/n): ").lower()
            if gen_option == 's':
                password = generate_secure_password(20)
                print(f"Contraseña generada: {password}")
            else:
                password = getpass(f"Ingresa la contraseña para {service}: ")

            encrypted = encrypt_data(password, key)
            vault[service] = encrypted
            save_vault(vault)
            
            # Opcional: copiar al portapapeles de una vez
            pyperclip.copy(password)
            print(f"¡Contraseña para '{service}' guardada y copiada al portapapeles!")

        elif choice == "2":
            service = input("Nombre del servicio a consultar: ").lower().strip()
            if service in vault:
                try:
                    decrypted_pw = decrypt_data(vault[service], key)
                    pyperclip.copy(decrypted_pw)
                    print(f"Contraseña para {service}: {decrypted_pw}")
                    print("¡Se ha copiado automáticamente al portapapeles!")
                except Exception:
                    print("Error: Contraseña maestra incorrecta o datos corruptos.")
            else:
                print("Servicio no encontrado.")

        elif choice == "3":
            if vault:
                print("\nServicios guardados:")
                for s in vault.keys():
                    print(f" - {s}")
            else:
                print("El baúl está vacío.")

        elif choice == "4":
            try:
                length = int(input("Longitud de la contraseña (por defecto 18): ") or 18)
            except ValueError:
                length = 18
            pw = generate_secure_password(length)
            pyperclip.copy(pw)
            print(f"\nContraseña generada: {pw}")
            print("¡Copiada al portapapeles!")

        elif choice == "5":
            print("Saliendo del gestor seguro...")
            break
        else:
            print("Opción no válida.")

if __name__ == "__main__":
    main()