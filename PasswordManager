# --- Usa Argon2id (más seguro); si no está disponible, cae a PBKDF2 ---
try:
    from argon2.low_level import hash_secret_raw, Type
    ARGON2_AVAILABLE = True
except ImportError:
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
    from cryptography.hazmat.primitives import hashes
    ARGON2_AVAILABLE = False

# ─────────────────────── CONFIGURACIÓN ───────────────────────
VAULT_FILE  = "vault.json"
SALT_FILE   = "salt.bin"
CLIPBOARD_CLEAR_SECONDS = 30   # segundos antes de limpiar portapapeles
VERSION     = "2.0"


# ─────────────────────── CRIPTOGRAFÍA ────────────────────────

def generate_key(master_password: str, salt: bytes) -> bytes:
    """Deriva una clave de 256 bits usando Argon2id (recomendado) o PBKDF2."""
    if ARGON2_AVAILABLE:
        return hash_secret_raw(
            secret=master_password.encode("utf-8"),
            salt=salt,
            time_cost=3,
            memory_cost=65536,   # 64 MB
            parallelism=2,
            hash_len=32,
            type=Type.ID,
        )
    else:
        kdf = PBKDF2HMAC(
            algorithm=hashes.SHA256(),
            length=32,
            salt=salt,
            iterations=600_000,
        )
        return kdf.derive(master_password.encode("utf-8"))


def encrypt_data(data: str, key: bytes) -> dict:
    """Cifra una cadena con AES-256-GCM y devuelve nonce + ciphertext en base64."""
    aesgcm = AESGCM(key)
    nonce  = os.urandom(12)
    ciphertext = aesgcm.encrypt(nonce, data.encode("utf-8"), None)
    return {
        "nonce":      base64.b64encode(nonce).decode(),
        "ciphertext": base64.b64encode(ciphertext).decode(),
    }


def decrypt_data(encrypted_dict: dict, key: bytes) -> str:
    """Descifra un dict {nonce, ciphertext} con AES-256-GCM."""
    aesgcm     = AESGCM(key)
    nonce      = base64.b64decode(encrypted_dict["nonce"])
    ciphertext = base64.b64decode(encrypted_dict["ciphertext"])
    return aesgcm.decrypt(nonce, ciphertext, None).decode("utf-8")


# ──────────────────── GENERADOR DE CONTRASEÑAS ───────────────

SPECIAL_CHARS = "!@#$%^&*()_+-=[]{}|;:,.<>?"

def generate_secure_password(length: int = 20) -> str:
    """Genera una contraseña criptográficamente segura que cumple todos los criterios."""
    alphabet = string.ascii_letters + string.digits + SPECIAL_CHARS
    while True:
        pw = "".join(secrets.choice(alphabet) for _ in range(length))
        if (
            any(c.islower() for c in pw)
            and any(c.isupper() for c in pw)
            and any(c.isdigit() for c in pw)
            and any(c in SPECIAL_CHARS for c in pw)
        ):
            return pw


# ─────────────────────── PERSISTENCIA ────────────────────────

def get_or_create_salt() -> bytes:
    if not os.path.exists(SALT_FILE):
        salt = os.urandom(32)          # 256 bits — más espacio para Argon2id
        with open(SALT_FILE, "wb") as f:
            f.write(salt)
        return salt
    with open(SALT_FILE, "rb") as f:
        return f.read()


def load_vault() -> dict:
    if not os.path.exists(VAULT_FILE):
        return {}
    with open(VAULT_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def save_vault(vault: dict) -> None:
    with open(VAULT_FILE, "w", encoding="utf-8") as f:
        json.dump(vault, f, indent=4, ensure_ascii=False)


# ─────────────────────── PORTAPAPELES ────────────────────────

_clipboard_timer: Optional[threading.Timer] = None

def copy_with_auto_clear(text: str, seconds: int = CLIPBOARD_CLEAR_SECONDS) -> None:
    """Copia texto al portapapeles y lo borra automáticamente tras `seconds` s."""
    global _clipboard_timer
    if _clipboard_timer is not None:
        _clipboard_timer.cancel()

    pyperclip.copy(text)

    def clear():
        try:
            if pyperclip.paste() == text:
                pyperclip.copy("")
        except Exception:
            pass

    _clipboard_timer = threading.Timer(seconds, clear)
    _clipboard_timer.daemon = True
    _clipboard_timer.start()


