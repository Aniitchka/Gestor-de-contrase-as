import json
import os
import base64
import string
import secrets
import pyperclip
import tkinter as tk
from tkinter import messagebox, simpledialog
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

VAULT_FILE = "vault.json"
SALT_FILE = "salt.bin"

# 1. Derivación de Clave (PBKDF2 + SHA256 con 600k iteraciones)
def generate_key(master_password: str, salt: bytes) -> bytes:
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=600000,
    )
    return kdf.derive(master_password.encode())

# 2. Cifrado con AES-256-GCM
def encrypt_data(data: str, key: bytes) -> dict:
    aesgcm = AESGCM(key)
    nonce = os.urandom(12)
    encrypted_bytes = aesgcm.encrypt(nonce, data.encode(), None)
    return {
        "nonce": base64.b64encode(nonce).decode('utf-8'),
        "ciphertext": base64.b64encode(encrypted_bytes).decode('utf-8')
    }

# 3. Descifrado con AES-256-GCM
def decrypt_data(encrypted_dict: dict, key: bytes) -> str:
    aesgcm = AESGCM(key)
    nonce = base64.b64decode(encrypted_dict["nonce"])
    ciphertext = base64.b64decode(encrypted_dict["ciphertext"])
    decrypted_bytes = aesgcm.decrypt(nonce, ciphertext, None)
    return decrypted_bytes.decode('utf-8')

# 4. Generador criptográfico de contraseñas
def generate_secure_password(length: int = 18) -> str:
    alphabet = string.ascii_letters + string.digits + "!@#$%^&*()_+-=[]{}|;:,.<>?"
    while True:
        password = ''.join(secrets.choice(alphabet) for _ in range(length))
        if (any(c.islower() for c in password) and
            any(c.isupper() for c in password) and
            any(c.isdigit() for c in password) and
            any(c in "!@#$%^&*()_+-=[]{}|;:,.<>?" for c in password)):
            return password

def get_or_create_salt() -> bytes:
    if not os.path.exists(SALT_FILE):
        salt = os.urandom(16)
        with open(SALT_FILE, "wb") as f:
            f.write(salt)
        return salt
    with open(SALT_FILE, "rb") as f:
        return f.read()

def load_vault() -> dict:
    if not os.path.exists(VAULT_FILE):
        return {}
    with open(VAULT_FILE, "r") as f:
        return json.load(f)

def save_vault(vault: dict):
    with open(VAULT_FILE, "w") as f:
        json.dump(vault, f, indent=4)


# --- INTERFAZ GRÁFICA (GUI) ---
class PasswordManagerApp:
    def __init__(self, root, key):
        self.root = root
        self.root.title("Secure Vault - Gestor de Contraseñas")
        self.root.geometry("620x450")
        self.key = key
        self.vault = load_vault()

        # Frame Izquierdo: Lista y Buscador
        left_frame = tk.Frame(root, padx=10, pady=10)
        left_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        tk.Label(left_frame, text="Servicios Guardados", font=("Arial", 12, "bold")).pack(anchor="w")
        
        # Barra de Búsqueda en tiempo real
        self.search_var = tk.StringVar()
        self.search_var.trace("w", self.filter_list)
        self.search_entry = tk.Entry(left_frame, textvariable=self.search_var, font=("Arial", 10))
        self.search_entry.pack(fill=tk.X, pady=5)
        self.search_entry.insert(0, "Buscar servicio...")
        self.search_entry.bind("<FocusIn>", lambda e: self.clear_placeholder())

        # Lista con Scrollbar
        list_frame = tk.Frame(left_frame)
        list_frame.pack(fill=tk.BOTH, expand=True, pady=5)
        
        self.scrollbar = tk.Scrollbar(list_frame, orient=tk.VERTICAL)
        self.listbox = tk.Listbox(list_frame, yscrollcommand=self.scrollbar.set, font=("Arial", 11))
        self.scrollbar.config(command=self.listbox.yview)
        self.scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        self.listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        # Frame Derecho: Botones de Acción
        right_frame = tk.Frame(root, padx=10, pady=10, width=180)
        right_frame.pack(side=tk.RIGHT, fill=tk.Y)

        tk.Label(right_frame, text="Acciones", font=("Arial", 12, "bold")).pack(anchor="w", pady=(0, 10))

        tk.Button(right_frame, text="Agregar / Editar", bg="#4CAF50", fg="white", font=("Arial", 9, "bold"), command=self.add_or_edit_service).pack(fill=tk.X, pady=5)
        tk.Button(right_frame, text="Copiar Clave", bg="#2196F3", fg="white", font=("Arial", 9, "bold"), command=self.copy_password).pack(fill=tk.X, pady=5)
        tk.Button(right_frame, text="Ver Clave", bg="#FF9800", fg="white", font=("Arial", 9, "bold"), command=self.view_password).pack(fill=tk.X, pady=5)
        tk.Button(right_frame, text="Eliminar", bg="#F44336", fg="white", font=("Arial", 9, "bold"), command=self.delete_service).pack(fill=tk.X, pady=5)
        tk.Button(right_frame, text="Generar Rápido", bg="#9C27B0", fg="white", font=("Arial", 9, "bold"), command=self.generate_and_copy_quick).pack(fill=tk.X, pady=5)

        self.update_listbox(self.vault.keys())

    def clear_placeholder(self):
        if self.search_entry.get() == "Buscar servicio...":
            self.search_entry.delete(0, tk.END)

    def filter_list(self, *args):
        query = self.search_var.get().lower()
        if query == "buscar servicio..." or not query:
            filtered = self.vault.keys()
        else:
            filtered = [s for s in self.vault.keys() if query in s]
        self.update_listbox(filtered)

    def update_listbox(self, items):
        self.listbox.delete(0, tk.END)
        for item in sorted(items):
            self.listbox.insert(tk.END, item)

    def get_selected_service(self):
        try:
            selection = self.listbox.curselection()
            if not selection:
                return None
            return self.listbox.get(selection[0])
        except Exception:
            return None

    def copy_password(self):
        service = self.get_selected_service()
        if not service:
            messagebox.showwarning("Atención", "Selecciona un servicio de la lista primero.")
            return
        try:
            decrypted_pw = decrypt_data(self.vault[service], self.key)
            pyperclip.copy(decrypted_pw)
            messagebox.showinfo("Copiado", f"¡Contraseña de '{service}' copiada al portapapeles!")
        except Exception:
            messagebox.showerror("Error", "No se pudo descifrar la contraseña.")

    def view_password(self):
        service = self.get_selected_service()
        if not service:
            messagebox.showwarning("Atención", "Selecciona un servicio de la lista primero.")
            return
        try:
            decrypted_pw = decrypt_data(self.vault[service], self.key)
            messagebox.showinfo(f"Contraseña de: {service}", f"{decrypted_pw}")
        except Exception:
            messagebox.showerror("Error", "No se pudo descifrar la contraseña.")

    def add_or_edit_service(self):
        dialog = tk.Toplevel(self.root)
        dialog.title("Agregar / Editar Servicio")
        dialog.geometry("350x230")
        dialog.grab_set()

        tk.Label(dialog, text="Nombre del Servicio (ej. github):", font=("Arial", 10)).pack(anchor="w", padx=20, pady=(15, 0))
        service_entry = tk.Entry(dialog, font=("Arial", 10), width=30)
        service_entry.pack(padx=20, pady=5)

        tk.Label(dialog, text="Contraseña (vacío para generar auto):", font=("Arial", 10)).pack(anchor="w", padx=20, pady=(5, 0))
        pass_entry = tk.Entry(dialog, show="*", font=("Arial", 10), width=30)
        pass_entry.pack(padx=20, pady=5)

        def save():
            service = service_entry.get().strip().lower()
            password = pass_entry.get()
            if not service:
                messagebox.showwarning("Error", "El nombre del servicio no puede estar vacío.")
                return
            
            if not password:
                password = generate_secure_password(20)
                messagebox.showinfo("Contraseña Generada", f"Se creó esta clave segura:\n{password}")

            encrypted = encrypt_data(password, self.key)
            self.vault[service] = encrypted
            save_vault(self.vault)
            pyperclip.copy(password)
            self.update_listbox(self.vault.keys())
            dialog.destroy()
            messagebox.showinfo("Éxito", f"¡Servicio '{service}' guardado y copiado!")

        tk.Button(dialog, text="Guardar en el Baúl", bg="#4CAF50", fg="white", font=("Arial", 10, "bold"), command=save).pack(pady=15)

    def delete_service(self):
        service = self.get_selected_service()
        if not service:
            messagebox.showwarning("Atención", "Selecciona un servicio para eliminar.")
            return
        
        if messagebox.askyesno("Confirmar Eliminación", f"¿Estás segura de eliminar '{service}' de tu baúl?"):
            del self.vault[service]
            save_vault(self.vault)
            self.update_listbox(self.vault.keys())
            messagebox.showinfo("Eliminado", f"El servicio '{service}' fue borrado.")

    def generate_and_copy_quick(self):
        pw = generate_secure_password(20)
        pyperclip.copy(pw)
        messagebox.showinfo("Generador Rápido", f"Contraseña segura generada y copiada:\n\n{pw}")


def main():
    salt = get_or_create_salt()
    
    # Ventana oculta temporalmente para pedir la Contraseña Maestra
    root_login = tk.Tk()
    root_login.withdraw()
    
    master_pw = simpledialog.askstring("Autenticación Requerida", "Ingresa tu contraseña maestra:", show="*")
    if not master_pw:
        return

    key = generate_key(master_pw, salt)
    
    # Validar clave maestra intentando descifrar el baúl si ya tiene registros
    try:
        vault = load_vault()
        if vault:
            first_key = list(vault.keys())[0]
            decrypt_data(vault[first_key], key)
    except Exception:
        messagebox.showerror("Acceso Denegado", "Contraseña maestra incorrecta o datos alterados.")
        return

    root_login.destroy()

    # Lanzar la aplicación gráfica principal
    main_root = tk.Tk()
    app = PasswordManagerApp(main_root, key)
    main_root.mainloop()

if __name__ == "__main__":
    main()
