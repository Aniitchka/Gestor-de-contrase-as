def login_screen() -> Optional[tuple[bytes, bytes]]:
    """Muestra la pantalla de login y devuelve (key, salt) o None si se cancela."""
    c = {
        "bg":      "#1e1e2e",
        "surface": "#313244",
        "text":    "#cdd6f4",
        "muted":   "#a6adc8",
        "green":   "#a6e3a1",
    }

    win = tk.Tk()
    win.title("Secure Vault — Autenticación")
    win.geometry("400x280")
    win.configure(bg=c["bg"])
    win.resizable(False, False)

    result = {"key": None, "salt": None}

    tk.Label(win, text="🔐", bg=c["bg"], font=("Segoe UI", 36)).pack(pady=(30, 4))
    tk.Label(win, text="Secure Vault", bg=c["bg"], fg=c["text"],
             font=("Segoe UI", 16, "bold")).pack()
    tk.Label(win, text="Ingresa tu contraseña maestra para continuar",
             bg=c["bg"], fg=c["muted"], font=("Segoe UI", 9)).pack(pady=(2, 16))

    pw_var   = tk.StringVar()
    show_var = tk.BooleanVar(value=False)
    pw_frame = tk.Frame(win, bg=c["bg"])
    pw_frame.pack(fill=tk.X, padx=40)

    pw_entry = tk.Entry(pw_frame, textvariable=pw_var, show="●",
                        font=("Segoe UI", 12), bg=c["surface"], fg=c["text"],
                        insertbackground=c["text"], relief="flat", bd=8)
    pw_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, ipady=4)
    pw_entry.focus_set()

    def toggle_show():
        pw_entry.config(show="" if show_var.get() else "●")
    tk.Checkbutton(pw_frame, text="👁", variable=show_var, command=toggle_show,
                   bg=c["bg"], fg=c["muted"], selectcolor=c["surface"],
                   activebackground=c["bg"], font=("Segoe UI", 11)).pack(side=tk.LEFT)

    kdf_name = "Argon2id" if ARGON2_AVAILABLE else "PBKDF2-SHA256 (instala argon2-cffi para Argon2id)"
    tk.Label(win, text=f"KDF: {kdf_name}", bg=c["bg"], fg=c["muted"],
             font=("Segoe UI", 8)).pack(pady=(6, 0))

    def attempt_login(event=None):
        master_pw = pw_var.get()
        if not master_pw:
            return

        salt = get_or_create_salt()
        key  = generate_key(master_pw, salt)

        # Validar contra el baúl existente
        try:
            vault = load_vault()
            if vault:
                first = next(iter(vault))
                decrypt_data(vault[first], key)
        except Exception:
            choice = messagebox.askyesno(
                "Acceso denegado",
                "La contraseña maestra no coincide con el baúl existente.\n\n"
                "¿Deseas ELIMINAR el baúl y empezar de cero?\n"
                "(Esta acción borrará todas tus contraseñas guardadas)",
                parent=win,
            )
            if choice:
                for f in (VAULT_FILE, SALT_FILE):
                    if os.path.exists(f):
                        os.remove(f)
                salt = get_or_create_salt()
                key  = generate_key(master_pw, salt)
            else:
                return

        result["key"]  = key
        result["salt"] = salt
        win.destroy()

    tk.Button(win, text="Entrar al Baúl", bg=c["green"], fg="#1e1e2e",
              font=("Segoe UI", 11, "bold"), relief="flat", cursor="hand2",
              command=attempt_login, pady=8).pack(fill=tk.X, padx=40, pady=14)

    pw_entry.bind("<Return>", attempt_login)
    win.mainloop()

    if result["key"] is None:
        return None
    return result["key"], result["salt"]


# ──────────────────────────── MAIN ───────────────────────────

def main() -> None:
    auth = login_screen()
    if auth is None:
        return

    key, _ = auth
    main_root = tk.Tk()
    PasswordManagerApp(main_root, key)
    main_root.mainloop()


if __name__ == "__main__":
    main()