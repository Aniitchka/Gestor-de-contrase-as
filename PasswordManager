    # ── Helpers ──

    def _set_status(self, msg: str, color: Optional[str] = None) -> None:
        self.status_var.set(msg)

    def refresh_list(self) -> None:
        query   = self.search_var.get().strip().lower()
        keys    = sorted(self.vault.keys())
        filtered = [k for k in keys if query in k or query in self.vault[k].get("user", "").lower()] if query else keys

        self.listbox.delete(0, tk.END)
        for service in filtered:
            user = self.vault[service].get("user", "")
            display = f"  {service:<22}  {user}"
            self.listbox.insert(tk.END, display)
        self.count_var.set(f"{len(filtered)} entrada(s)")

    def _selected_service(self) -> Optional[str]:
        sel = self.listbox.curselection()
        if not sel:
            messagebox.showwarning("Atención", "Selecciona un servicio de la lista primero.")
            return None
        raw = self.listbox.get(sel[0])
        # Extraer nombre de servicio (primera columna)
        return raw.strip().split()[0]

    def _decrypt_service(self, service: str) -> Optional[str]:
        try:
            return decrypt_data(self.vault[service], self.key)
        except Exception:
            messagebox.showerror("Error de descifrado",
                                 f"No se pudo descifrar '{service}'.\n"
                                 "La contraseña maestra puede ser incorrecta.")
            return None

    # ── Acciones ──

    def copy_password(self) -> None:
        service = self._selected_service()
        if not service:
            return
        pw = self._decrypt_service(service)
        if pw is None:
            return
        copy_with_auto_clear(pw, CLIPBOARD_CLEAR_SECONDS)
        self._set_status(f"'{service}' copiado • se limpiará en {CLIPBOARD_CLEAR_SECONDS}s")
        messagebox.showinfo("Copiado ✓",
                            f"Contraseña de «{service}» copiada.\n"
                            f"El portapapeles se limpiará en {CLIPBOARD_CLEAR_SECONDS} segundos.")

    def view_password(self) -> None:
        service = self._selected_service()
        if not service:
            return
        pw = self._decrypt_service(service)
        if pw is None:
            return
        user = self.vault[service].get("user", "—")

        win = tk.Toplevel(self.root)
        win.title(f"Contraseña  •  {service}")
        win.geometry("360x200")
        win.configure(bg=self.DARK["bg"])
        win.grab_set()
        win.resizable(False, False)

        c = self.DARK
        tk.Label(win, text=service, bg=c["bg"], fg=c["text"],
                 font=("Segoe UI", 13, "bold")).pack(pady=(20, 4))
        tk.Label(win, text=f"Usuario: {user}", bg=c["bg"], fg=c["muted"],
                 font=("Segoe UI", 10)).pack()

        pw_var   = tk.StringVar(value=pw)
        show_var = tk.BooleanVar(value=False)
        pw_entry = tk.Entry(win, textvariable=pw_var, show="●",
                            font=("Segoe UI", 12), bg=c["surface"], fg=c["text"],
                            relief="flat", bd=8, state="readonly",
                            readonlybackground=c["surface"])
        pw_entry.pack(fill=tk.X, padx=24, pady=10)

        def toggle():
            pw_entry.config(show="" if show_var.get() else "●")

        btn_row = tk.Frame(win, bg=c["bg"])
        btn_row.pack()
        tk.Checkbutton(btn_row, text="Mostrar", variable=show_var, command=toggle,
                       bg=c["bg"], fg=c["muted"], selectcolor=c["surface"],
                       activebackground=c["bg"], activeforeground=c["text"],
                       font=("Segoe UI", 9)).pack(side=tk.LEFT, padx=4)
        tk.Button(btn_row, text="Copiar", bg=c["blue"], fg=c["bg"],
                  font=("Segoe UI", 9, "bold"), relief="flat", cursor="hand2",
                  command=lambda: [copy_with_auto_clear(pw, CLIPBOARD_CLEAR_SECONDS),
                                   win.destroy()]).pack(side=tk.LEFT, padx=4)
        tk.Button(btn_row, text="Cerrar", bg=c["surface"], fg=c["text"],
                  font=("Segoe UI", 9), relief="flat", cursor="hand2",
                  command=win.destroy).pack(side=tk.LEFT, padx=4)

    def add_or_edit_service(self, prefill: str = "") -> None:
        dialog = AddEditDialog(self.root, self.key, self.vault, prefill)
        self.root.wait_window(dialog)
        if dialog.result is None:
            return

        service, user, password, generated = dialog.result

        if service in self.vault and service != prefill:
            if not messagebox.askyesno("Servicio existente",
                                       f"'{service}' ya existe. ¿Deseas sobrescribirlo?"):
                return

        if generated:
            messagebox.showinfo("Contraseña generada",
                                f"Clave segura creada:\n\n{password}\n\n"
                                f"Se copiará automáticamente al portapapeles.")

        encrypted = encrypt_data(password, self.key)
        encrypted["user"] = user
        self.vault[service] = encrypted
        save_vault(self.vault)

        copy_with_auto_clear(password, CLIPBOARD_CLEAR_SECONDS)
        self.refresh_list()
        self._set_status(f"'{service}' guardado y copiado.")
        if not generated:
            messagebox.showinfo("Guardado ✓", f"«{service}» guardado correctamente.")

    def delete_service(self) -> None:
        service = self._selected_service()
        if not service:
            return
        if messagebox.askyesno("Confirmar eliminación",
                                f"¿Eliminar «{service}» del baúl?\n\nEsta acción es irreversible."):
            del self.vault[service]
            save_vault(self.vault)
            self.refresh_list()
            self._set_status(f"'{service}' eliminado.")

    def generate_quick(self) -> None:
        win = tk.Toplevel(self.root)
        win.title("Generador rápido")
        win.geometry("360x180")
        win.configure(bg=self.DARK["bg"])
        win.grab_set()
        win.resizable(False, False)

        c = self.DARK
        tk.Label(win, text="Longitud:", bg=c["bg"], fg=c["text"],
                 font=("Segoe UI", 10)).pack(pady=(20, 4))
        length_var = tk.IntVar(value=20)
        tk.Spinbox(win, from_=12, to=64, textvariable=length_var, width=6,
                   bg=c["surface"], fg=c["text"], buttonbackground=c["surface"],
                   relief="flat", font=("Segoe UI", 11)).pack()

        pw_var = tk.StringVar()
        pw_lbl = tk.Label(win, textvariable=pw_var, bg=c["bg"], fg=c["green"],
                          font=("Segoe UI", 11, "bold"), wraplength=320)
        pw_lbl.pack(pady=8)

        def do_generate():
            pw = generate_secure_password(length_var.get())
            pw_var.set(pw)
            copy_with_auto_clear(pw, CLIPBOARD_CLEAR_SECONDS)
            self._set_status(f"Generada y copiada • se limpiará en {CLIPBOARD_CLEAR_SECONDS}s")

        tk.Button(win, text="Generar y copiar", bg=c["purple"], fg=c["bg"],
                  font=("Segoe UI", 10, "bold"), relief="flat", cursor="hand2",
                  command=do_generate, pady=6).pack(fill=tk.X, padx=24)
        do_generate()


