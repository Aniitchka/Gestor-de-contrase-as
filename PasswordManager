class AddEditDialog(tk.Toplevel):
    """Diálogo para agregar o editar un servicio con usuario y contraseña."""

    def __init__(self, parent, key: bytes, vault: dict, existing_service: str = ""):
        super().__init__(parent)
        self.key   = key
        self.vault = vault
        self.result: Optional[tuple[str, str, str]] = None  # (service, user, password)
        self.existing = existing_service

        self.title("Agregar / Editar Servicio")
        self.geometry("380x310")
        self.resizable(False, False)
        self.grab_set()
        self.configure(bg="#1e1e2e")

        pad = {"padx": 24, "pady": 5}

        tk.Label(self, text="Servicio (ej. github):", bg="#1e1e2e", fg="#cdd6f4",
                 font=("Segoe UI", 10)).pack(anchor="w", **pad)
        self.service_var = tk.StringVar(value=existing_service)
        tk.Entry(self, textvariable=self.service_var, font=("Segoe UI", 10),
                 bg="#313244", fg="#cdd6f4", insertbackground="#cdd6f4",
                 relief="flat", bd=6).pack(fill=tk.X, **pad)

        tk.Label(self, text="Usuario / Email:", bg="#1e1e2e", fg="#cdd6f4",
                 font=("Segoe UI", 10)).pack(anchor="w", **pad)
        self.user_var = tk.StringVar()
        # Si ya existe, prellenar el usuario (sin descifrar contraseña aquí)
        if existing_service and existing_service in vault:
            entry = vault[existing_service]
            try:
                self.user_var.set(entry.get("user", ""))
            except Exception:
                pass
        tk.Entry(self, textvariable=self.user_var, font=("Segoe UI", 10),
                 bg="#313244", fg="#cdd6f4", insertbackground="#cdd6f4",
                 relief="flat", bd=6).pack(fill=tk.X, **pad)

        tk.Label(self, text="Contraseña (vacío = generar automáticamente):",
                 bg="#1e1e2e", fg="#cdd6f4", font=("Segoe UI", 10)).pack(anchor="w", **pad)

        pass_frame = tk.Frame(self, bg="#1e1e2e")
        pass_frame.pack(fill=tk.X, padx=24, pady=5)
        self.show_pw = tk.BooleanVar(value=False)
        self.pass_var = tk.StringVar()
        self.pass_entry = tk.Entry(pass_frame, textvariable=self.pass_var, show="●",
                                   font=("Segoe UI", 10), bg="#313244", fg="#cdd6f4",
                                   insertbackground="#cdd6f4", relief="flat", bd=6)
        self.pass_entry.pack(side=tk.LEFT, fill=tk.X, expand=True)
        tk.Checkbutton(pass_frame, text="Ver", variable=self.show_pw,
                       command=self._toggle_show, bg="#1e1e2e", fg="#cdd6f4",
                       selectcolor="#313244", activebackground="#1e1e2e",
                       activeforeground="#cdd6f4", font=("Segoe UI", 9)).pack(side=tk.LEFT, padx=(6, 0))

        # Longitud de contraseña generada
        len_frame = tk.Frame(self, bg="#1e1e2e")
        len_frame.pack(fill=tk.X, padx=24, pady=(4, 0))
        tk.Label(len_frame, text="Longitud al generar:", bg="#1e1e2e", fg="#a6adc8",
                 font=("Segoe UI", 9)).pack(side=tk.LEFT)
        self.length_var = tk.IntVar(value=20)
        tk.Spinbox(len_frame, from_=12, to=64, textvariable=self.length_var, width=4,
                   bg="#313244", fg="#cdd6f4", buttonbackground="#45475a",
                   relief="flat", font=("Segoe UI", 9)).pack(side=tk.LEFT, padx=6)

        tk.Button(self, text="Guardar en el Baúl", bg="#a6e3a1", fg="#1e1e2e",
                  font=("Segoe UI", 10, "bold"), relief="flat", cursor="hand2",
                  command=self._save, pady=8).pack(fill=tk.X, padx=24, pady=(18, 6))

    def _toggle_show(self):
        self.pass_entry.config(show="" if self.show_pw.get() else "●")

    def _save(self):
        service  = self.service_var.get().strip().lower()
        user     = self.user_var.get().strip()
        password = self.pass_var.get()

        if not service:
            messagebox.showwarning("Error", "El nombre del servicio no puede estar vacío.", parent=self)
            return

        generated = False
        if not password:
            password  = generate_secure_password(self.length_var.get())
            generated = True

        self.result = (service, user, password, generated)
        self.destroy()


